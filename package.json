{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:stats": "node scripts/generate-site-statistics.js",
    "docusaurus": "docusaurus",
    "start": "npm run generate:stats && docusaurus start",
    "build": "npm run generate:stats && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run generate:stats && docusaurus deploy",
    "deploy:bt": "pwsh -ExecutionPolicy Bypass -File scripts/deploy-to-bt.ps1",
    "deploy:bt:watch": "node scripts/deploy-watch.js",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "husky": "husky install"
  },
  "dependencies": {
    "@docusaurus/core": "^2.2.0",
    "@docusaurus/preset-classic": "^2.2.0",
    "@easyops-cn/docusaurus-search-local": "^0.36.0",
    "@mdx-js/react": "^1.6.21",
    "clsx": "^1.1.1",
    "katex": "^0.16.9",
    "prism-react-renderer": "^1.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-icons": "^5.6.0",
    "react-responsive": "^9.0.0",
    "react-scroll-parallax": "^3.3.1",
    "rehype-katex": "^4.0.0",
    "remark-math": "^3.0.1",
    "tippy.js": "^6.3.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "husky": "^8.0.1"
  }
}
